						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from FactBookings where booking_date > '@{activity('lastload').output.firstRow.watermarkvalue}' and booking_date <= '@{activity('latestload').output.firstRow.newwatermarkvalue}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
